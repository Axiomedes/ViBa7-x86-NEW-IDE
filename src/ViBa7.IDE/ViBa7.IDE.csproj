<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ViBa7.ProjectModel\ViBa7.ProjectModel.csproj" />
    <ProjectReference Include="..\ViBa7.ActiveXHost\ViBa7.ActiveXHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SyntaxHighlighting\VB6.xshd" />
    <Resource Include="Resources\ViBa7-x86.ico" />
    <Resource Include="Resources\ViBa7.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x86;x64;AnyCPU</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\ViBa7-x86.ico</ApplicationIcon>
    <RootNamespace>ViBa7.IDE</RootNamespace>
    <AssemblyName>ViBa7.IDE</AssemblyName>
    <ApplicationTitle>ViBa7-x86 IDE</ApplicationTitle>
    <Product>ViBa7-x86 IDE</Product>
    <Description>Entorno de Desarrollo y Diseñador Visual ViBa7 (Compatibilidad con VB6 SP6)</Description>
  </PropertyGroup>

</Project>
