<UserControl x:Class="ViBa7.IDE.Designer.PropertyGridPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ViBa7.IDE.Designer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="280"
             Background="#F5F5F7">
    <UserControl.Resources>
        <!-- Plantillas de Editores según tipo de propiedad -->
        <DataTemplate x:Key="TextEditorTemplate">
            <TextBox Text="{Binding CurrentValue, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="4,2"
                     BorderThickness="0" VerticalContentAlignment="Center"
                     IsReadOnly="{Binding IsReadOnly}"
                     KeyDown="PropertyTextBox_KeyDown"
                     LostFocus="PropertyTextBox_LostFocus"/>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceEditorTemplate">
            <ComboBox SelectedValue="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="RawValue" DisplayMemberPath="DisplayText"
                      ItemsSource="{Binding Choices}" FontSize="11" Height="22" BorderThickness="0"
                      SelectionChanged="PropertyChoice_SelectionChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="ColorEditorTemplate">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="💧" Width="18" Height="20" Padding="0" Margin="0,0,1,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Gotero / Cuentagotas (capturar color de cualquier superficie o aplicación externa)"
                            Click="BtnEyedropper_Click"/>
                    <Button Content="🎨" Width="18" Height="20" Padding="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Elegir color de la paleta" Click="BtnPickColor_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="16" Height="16" Margin="4,0,2,0" BorderBrush="#888888" BorderThickness="1"
                        Background="{Binding ColorBrush}"/>
                <TextBox Text="{Binding CurrentValue, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="2,2"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         KeyDown="PropertyTextBox_KeyDown"
                         LostFocus="PropertyTextBox_LostFocus"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PictureEditorTemplate">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="✖" Width="18" Height="20" Padding="0" Margin="1,0,1,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#888888"
                            ToolTip="Quitar imagen ((None))" Click="BtnClearPicture_Click"/>
                    <Button Content="..." Width="20" Height="20" Padding="0" Margin="1,0,2,0"
                            Background="#ECECEC" BorderBrush="#C0CAD4" BorderThickness="1" Cursor="Hand"
                            ToolTip="Seleccionar imagen desde archivo..." Click="BtnBrowsePicture_Click"/>
                </StackPanel>
                <TextBox Text="{Binding CurrentValue, Mode=OneWay}" FontSize="11" Padding="4,2"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="Transparent"
                         KeyDown="PropertyPicture_KeyDown"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="CustomDialogEditorTemplate">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="..." Width="22" Height="20" Padding="0" Margin="1,0,2,0"
                        Background="#ECECEC" BorderBrush="#C0CAD4" BorderThickness="1" Cursor="Hand"
                        FontWeight="Bold"
                        ToolTip="Abrir Páginas de Propiedades (Custom)..." Click="BtnOpenPropertyPages_Click"/>
                <TextBox Text="{Binding CurrentValue, Mode=OneWay}" FontSize="11" Padding="4,2"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="Transparent" Cursor="Hand"
                         MouseDoubleClick="CustomPropertyText_MouseDoubleClick"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="FontEditorTemplate">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="..." Width="22" Height="20" Padding="0" Margin="1,0,2,0"
                        Background="#ECECEC" BorderBrush="#C0CAD4" BorderThickness="1" Cursor="Hand"
                        FontWeight="Bold"
                        ToolTip="Seleccionar fuente tipográfica (Font / StdFont)..." Click="BtnBrowseFont_Click"/>
                <TextBox Text="{Binding CurrentValue, Mode=OneWay}" FontSize="11" Padding="4,2"
                         BorderThickness="0" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="Transparent" Cursor="Hand"
                         MouseDoubleClick="PropertyFont_MouseDoubleClick"/>
            </DockPanel>
        </DataTemplate>

        <local:PropertyTemplateSelector x:Key="PropValueTemplateSelector"
            TextTemplate="{StaticResource TextEditorTemplate}"
            ChoiceTemplate="{StaticResource ChoiceEditorTemplate}"
            ColorTemplate="{StaticResource ColorEditorTemplate}"
            PictureTemplate="{StaticResource PictureEditorTemplate}"
            CustomDialogTemplate="{StaticResource CustomDialogEditorTemplate}"
            FontTemplate="{StaticResource FontEditorTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Barra de Título / Encabezado -->
        <Border Grid.Row="0" Background="#E8EEF5" BorderBrush="#C5D3E8" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBlock Text="🏷️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle" Text="Propiedades" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E395B" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 2. Selector de Objeto (Formulario o Control) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,3">
            <ComboBox x:Name="CmbObjects" DisplayMemberPath="DisplayName" FontSize="11.5"
                      SelectionChanged="CmbObjects_SelectionChanged" Height="24"
                      ToolTip="Seleccionar formulario o control para editar propiedades"/>
        </Border>

        <!-- 3. Barra de Modos de Vista y Búsqueda -->
        <Border Grid.Row="2" Background="#ECECEC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="RadioAlphabetical" Content="🔤 Alfabético" GroupName="PropViewMode"
                                 IsChecked="True" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Checked="RadioViewMode_Checked"/>
                    <RadioButton x:Name="RadioCategorized" Content="🗂️ Categorías" GroupName="PropViewMode"
                                 FontSize="10" VerticalAlignment="Center"
                                 Checked="RadioViewMode_Checked"/>
                </StackPanel>
                <TextBox x:Name="TxtFilter" FontSize="10.5" Height="20" Margin="8,0,0,0" Padding="3,1"
                         BorderThickness="1" BorderBrush="#C0CAD4" VerticalContentAlignment="Center"
                         TextChanged="TxtFilter_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Filtrar..." Foreground="#999999" FontSize="10.5"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- 4. Lista / Grilla de Propiedades -->
        <ListView x:Name="PropertiesListView" Grid.Row="3" BorderThickness="0" Background="#FFFFFF"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="PropertiesListView_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#EBEBEB"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E3EDF8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nombre de la propiedad -->
                        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="5,2"
                                MouseLeftButtonDown="PropertyName_MouseLeftButtonDown" Cursor="IBeam">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#333333"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Description}"/>
                        </Border>

                        <!-- Editor del valor -->
                        <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource PropValueTemplateSelector}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 5. Panel Inferior de Descripción / Ayuda -->
        <Border Grid.Row="4" Background="#F0F4F8" BorderBrush="#C5D3E8" BorderThickness="0,1,0,0" Padding="6,4" MinHeight="48">
            <StackPanel>
                <TextBlock x:Name="TxtHelpPropName" Text="Propiedad" FontWeight="Bold" FontSize="11" Foreground="#1E395B"/>
                <TextBlock x:Name="TxtHelpDescription" Text="Selecciona una propiedad para ver su descripción."
                           FontSize="10.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
