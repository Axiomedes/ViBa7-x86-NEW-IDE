<UserControl x:Class="ViBa7.IDE.Designer.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="140"
             Background="#F5F5F7">
    <UserControl.Resources>
        <Style x:Key="ToolboxButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2EBF5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A3C2E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C9DCF3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3370B5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título del Panel de Herramientas -->
        <Border Grid.Row="0" Background="#E8EEF5" BorderBrush="#C5D3E8" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleViewMode" ToolTip="Alternar vista compacta (2 columnas) o con nombres"
                            Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnToggleViewMode_Click">
                        <TextBlock Text="⊞" FontSize="11" Foreground="#445566"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛠️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Caja de Herramientas" FontWeight="SemiBold" FontSize="11.5" Foreground="#1E395B" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cabecera de Categoría Plegable (General) -->
        <Border Grid.Row="1" Background="#ECECEC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="True">
                <TextBlock Text="▼ General" FontSize="10" FontWeight="Bold" Foreground="#666666" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Lista de Herramientas -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ToolsItemsControl" Margin="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel x:Name="ToolsPanel" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Margin="1"
                                      IsEnabled="{Binding IsEnabled}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="ToolButton_Click"
                                      MouseDoubleClick="ToolButton_MouseDoubleClick"
                                      ToolTip="{Binding ToolTip}"
                                      Style="{StaticResource ToolboxButtonStyle}"
                                      Width="{Binding ElementName=ToolsItemsControl, Path=DataContext.ItemWidth}"
                                      Height="26">
                            <DockPanel LastChildFill="True" Margin="2,0">
                                <Image Source="{Binding IconSource}" Width="16" Height="16"
                                       VerticalAlignment="Center" Margin="2,0,3,0"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center"
                                           Margin="3,0,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ElementName=ToolsItemsControl, Path=DataContext.TextVisibility}"/>
                            </DockPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
