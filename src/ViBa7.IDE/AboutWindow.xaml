<Window x:Class="ViBa7.IDE.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de ViBa7-x86 IDE"
        Icon="Resources/ViBa7-x86.ico"
        Height="540" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Imagen ViBa7.png del producto -->
            <Border Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Background="Transparent" CornerRadius="4">
                <Image Source="Resources/ViBa7.png" Width="96" Height="96" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ViBa7-x86 IDE" FontSize="20" FontWeight="Bold" Foreground="#003399"/>
                <TextBlock x:Name="TxtAuthor" Text="Author: David Rojas [Axio.UK]" FontSize="12.5" FontWeight="SemiBold" Foreground="#222222" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="TxtVersion" Text="Versión: 00.001.0636" FontSize="12" FontWeight="Bold" Foreground="#0055AA"/>
                    <TextBlock Text="  •  " FontSize="12" Foreground="#888888"/>
                    <TextBlock x:Name="TxtLicenseHeader" Text="Licencia: GPL-3.0" FontSize="12" FontWeight="SemiBold" Foreground="#107C41"/>
                </StackPanel>
                <TextBlock Text="Entorno de Desarrollo y Diseñador Visual ViBa7 (Compatibilidad con VB6 SP6 / Win-x86)" FontSize="11" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel TextBlock.FontSize="11.5">
                    <TextBlock Text="Detalles del Entorno y Plataforma:" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtPlatform" Text="• Plataforma: Windows x86 (Nativo 32-bit / WOW64)" Margin="4,2"/>
                    <TextBlock x:Name="TxtRuntime" Text="• Runtime: .NET 10 LTS" Margin="4,2"/>
                    <TextBlock x:Name="TxtEditor" Text="• Motor de Edición: AvalonEdit" Margin="4,2"/>
                    
                    <Separator Margin="0,10,0,10" Background="#E5E7EB"/>
                    <TextBlock Text="Licencia y Términos Legales:" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtLicenseDetail" Text="• Licencia: GNU General Public License v3.0 (GPL-3.0)" FontWeight="Medium" Foreground="#107C41" Margin="4,2"/>
                    <TextBlock Text="• Software Libre: Libertad de uso, estudio, modificación y redistribución bajo los términos de la GPLv3." FontSize="11" Foreground="#666666" Margin="4,1"/>

                    <Separator Margin="0,10,0,10" Background="#E5E7EB"/>
                    <TextBlock Text="Declaración y Marcas Registradas:" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
                    <TextBlock Text="Este proyecto es un desarrollo independiente y no está afiliado, patrocinado ni respaldado por Microsoft. Las referencias a Visual Basic 6.0 y a otros productos de terceros se utilizan exclusivamente para identificar tecnologías y formatos (Compatibilidad con VB6 SP6). Las marcas mencionadas pertenecen a sus respectivos titulares." TextWrapping="Wrap" FontSize="11" Foreground="#555555" Margin="4,2"/>

                    <Separator Margin="0,10,0,10" Background="#E5E7EB"/>
                    <TextBlock Text="Capacidades y Subsistemas:" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
                    <TextBlock Text="• Diseñador Visual WYSIWYG de Formularios y Controles (.frm)" Margin="4,2"/>
                    <TextBlock Text="• Persistencia OLE StdPicture canónica en recursos binarios (.frx)" Margin="4,2"/>
                    <TextBlock Text="• Ejecución en Caliente (Hot-Run / F5) con Ventana Inmediata y depuración" Margin="4,2"/>
                    <TextBlock Text="• Toolchain desacoplado: Compilación x32 (Compatibilidad con VB6 SP6) y x64 (Proyectos nuevos)" Margin="4,2"/>
                    <TextBlock Text="• Lector e integración de TypeLibs COM y controles OCX" Margin="4,2"/>
                    <TextBlock Text="• Editor de Menús jerárquico integrado (Ctrl+E)" Margin="4,2"/>
                    <TextBlock Text="• Preservación estricta de ANSI, CRLF y retrocompatibilidad con VB6 SP6" Margin="4,2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Aceptar" Width="90" Height="26" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
